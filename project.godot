; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TrioWorld"
run/main_scene="res://Screen Prefab/Home Screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/image="res://Loading.png"

[audio]

buses/default_bus_layout="res://Sound/Manager/default_bus_layout.tres"
video/video_delay_compensation_ms=-2

[autoload]

PlayFabManager="*res://addons/godot-playfab/PlayFabManager.gd"
LeaderboardData="*res://Script/leaderboardData.gd"
GameManager="*res://Script/game_manager.gd"
InGameUiManager="*res://Script/InGameUIManager.gd"
AudioManager="*res://Sound/Manager/audio_manager.tscn"
VolumnManager="*res://Sound/Manager/volume_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=1080
window/size/window_height_override=1920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[dotnet]

project/assembly_name="JumpGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-playfab/plugin.cfg")

[input]

ui_left={
"deadzone": 0.5,
"events": []
}
ui_right={
"deadzone": 0.5,
"events": []
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[playfab]

title_id="24F9C"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
